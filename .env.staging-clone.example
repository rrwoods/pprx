# Local configuration for scripts/clone_prod_to_staging.ps1.
# Copy this file to .env.staging-clone (gitignored) and fill in local values.
# Passwords are prompted interactively via Read-Host -AsSecureString unless
# supplied via PPRX_DUMP_PASSWORD / PPRX_STAGING_PASSWORD environment variables.

DB_HOST=your-do-mysql-cluster.b.db.ondigitalocean.com
DB_PORT=25060
DB_CA_CERT_PATH=C:\path\to\ca-certificate.crt
PPRX_DUMP_USER=pprx_dump
PPRX_STAGING_USER=pprx_staging

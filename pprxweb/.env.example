# Django Secret Key (generate a random string for local dev)
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-change-me

# 3icecream OAuth API credentials (required for user authentication and score sync)
CLIENT_ID=your-3icecream-client-id
CLIENT_SECRET=your-3icecream-client-secret

# Email configuration (for account verification and password reset emails)
GOOGLE_USERNAME=your-email@gmail.com
GOOGLE_APP_PASSWORD=your-google-app-password

# Database configuration (optional - omit to use local SQLite pprx.db by default)
# DATABASE_URL=mysql://user:password@localhost:3306/pprx
